<# : batch launcher (PowerShell reads this block as a comment)
@echo off
setlocal
set "LINEAGE_BUNDLE=%~f0"
set "LINEAGE_ARGS=%*"
rem Prefer PowerShell 7; otherwise 64-bit Windows PowerShell, even when started from a 32-bit process such as an
rem Orchestrator runbook server (Sysnative is only visible to 32-bit processes).
set "LINEAGE_PS=powershell"
if exist "%SystemRoot%\Sysnative\WindowsPowerShell\v1.0\powershell.exe" set "LINEAGE_PS=%SystemRoot%\Sysnative\WindowsPowerShell\v1.0\powershell.exe"
where pwsh >nul 2>nul
if %errorlevel%==0 set "LINEAGE_PS=pwsh"
if not defined LINEAGE_ARGS goto interactive
rem Arguments given: unattended run for orchestrators. No prompts, no pause, exit code 0 or 1.
%LINEAGE_PS% -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "$t = [IO.File]::ReadAllText($env:LINEAGE_BUNDLE); Invoke-Expression $t.Substring(0, $t.IndexOf('#====' + ' FILES ===='))"
exit /b %errorlevel%
:interactive
%LINEAGE_PS% -NoProfile -ExecutionPolicy Bypass -Command "$t = [IO.File]::ReadAllText($env:LINEAGE_BUNDLE); Invoke-Expression $t.Substring(0, $t.IndexOf('#====' + ' FILES ===='))"
echo.
if errorlevel 1 (echo The run did not finish. The message above explains why.) else (echo Finished.)
pause
exit /b
#>

# Power BI report lineage: finds the database, schema and table behind every Power BI report.
# Source and instructions: https://github.com/DATA-AI-XYZ/PowerBI-Automation-Script/tree/main/scripts/administration/PowerBI-Lineage
#
# Double-click to run, or run with arguments for unattended use (PowerBI-Lineage.cmd /? for help).
# The scripts it runs are stored as plain text below the FILES marker. They are unpacked
# to %LOCALAPPDATA%\PowerBI-Lineage\<version> and started from there. Nothing else on the machine changes,
# apart from the two PowerShell modules the script installs for the current user if they are missing.
# Generated by build/New-LineageBundle.ps1 from src/; edit those files, not this one.

$ErrorActionPreference = 'Stop'
$bundleText = [IO.File]::ReadAllText($env:LINEAGE_BUNDLE)
$payload = $bundleText.Substring($bundleText.IndexOf('#====' + ' FILES ===='))

$sha = [Security.Cryptography.SHA256]::Create()
$version = -join ($sha.ComputeHash([Text.Encoding]::UTF8.GetBytes($payload))[0..5] | ForEach-Object { $_.ToString('x2') })
# Service accounts do not always have LOCALAPPDATA set.
$localAppData = $env:LOCALAPPDATA
if (-not $localAppData) { $localAppData = [Environment]::GetFolderPath('LocalApplicationData') }
if (-not $localAppData) { $localAppData = Join-Path ([IO.Path]::GetTempPath()) 'LocalAppData' }
$installRoot = Join-Path $localAppData 'PowerBI-Lineage'
$target = Join-Path $installRoot $version

if (-not (Test-Path -LiteralPath (Join-Path $target '.complete'))) {
    $parts = [regex]::Split($payload, '(?m)^#==== FILE: (.+?) ====\r?\n')
    for ($i = 1; $i -lt $parts.Count; $i += 2) {
        $path = Join-Path $target $parts[$i]
        $null = New-Item -ItemType Directory -Force -Path (Split-Path -Parent $path)
        [IO.File]::WriteAllText($path, $parts[$i + 1], (New-Object Text.UTF8Encoding $true))
    }
    Set-Content -LiteralPath (Join-Path $target '.complete') -Value $version
    Get-ChildItem -LiteralPath $installRoot -Directory | Where-Object Name -ne $version |
        Remove-Item -Recurse -Force -ErrorAction SilentlyContinue
}

$lineageScript = Join-Path $target 'src\Get-PbiReportLineage.ps1'

if ($env:LINEAGE_ARGS) {
    # Unattended: arguments are read as literal parameter values only, never run as code.
    try {
        Import-Module (Join-Path $target 'src\modules\LauncherArguments.psm1') -Force
        $parameters = ConvertFrom-LauncherArgument $env:LINEAGE_ARGS
        if ($parameters.ContainsKey('Help')) {
            Get-LauncherUsage
            exit 0
        }
        & $lineageScript @parameters -Unattended
        exit 0
    }
    catch {
        [Console]::Error.WriteLine("ERROR: $($_.Exception.Message)")
        exit 1
    }
}

try {
    & $lineageScript -Interactive
}
catch {
    Write-Host ''
    Write-Host $_.Exception.Message -ForegroundColor Red
    exit 1
}
return
